# ─── HealthNexus BD — backend environment (TEMPLATE) ─────────────
# Copy to .env and fill real values. NEVER commit the real .env.
# Full reference: ../docs/ENV.md

# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Proxies in front of the API: 0 locally, 1 on Render
TRUST_PROXY=0

# Database — Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"

# JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# AES-256 record/file encryption (64 hex chars)
AES_SECRET_KEY=change_me

# OTP behaviour
OTP_MODE=demo            # real | demo  (demo = code shown on screen, no SMS). Unset: real in production, demo otherwise
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SESSION_TTL_MINUTES=30

# Google Gemini (AI clinical summary) — add later
GEMINI_API_KEY=

# BulkSMSBD (consent OTP via SMS) — add later
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=https://bulksmsbd.net/api/smsapi
# Most real SMS per day (each costs money)
SMS_DAILY_LIMIT=50

# Gmail SMTP (forgot-password OTP) — add later
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=HealthNexus BD <no-reply@healthnexus.bd>

# Cloudinary (encrypted lab report PDFs) — add later
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Uploads (dev fallback)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Seed (optional): make the first demo patient your own account, with your real phone
# (it then gets real SMS). Leave empty to keep the made-up demo patient.
SEED_OWNER_EMAIL=
SEED_OWNER_PHONE=
SEED_OWNER_NAME=
