# ─── HealthNexus BD — backend environment (TEMPLATE) ─────────────
# Copy to backend/.env and fill real values. NEVER commit the real .env.

# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Neon / Supabase pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_32+_random_chars
JWT_REFRESH_SECRET=change_me_different_32+_random_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# AES-256 record/file encryption (generate 64 hex chars):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=change_me_64_hex_chars

# Google Gemini (AI clinical summary)
GEMINI_API_KEY=your_gemini_api_key

# OTP behavior
OTP_MODE=real            # real | demo  (demo = print OTP, no external send)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SESSION_TTL_MINUTES=30

# SMS — BulkSMSBD (consent OTP)
SMS_API_KEY=your_bulksmsbd_api_key
SMS_SENDER_ID=your_sender_id
SMS_API_URL=http://bulksmsbd.net/api/smsapi

# Email — Gmail SMTP (forgot-password OTP)
EMAIL_USER=yourproject@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=HealthNexus BD <yourproject@gmail.com>

# Uploads (lab report PDFs, dev)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
