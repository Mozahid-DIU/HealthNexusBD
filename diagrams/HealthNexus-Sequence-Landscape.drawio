        <!-- Phase B -->
        <mxCell id="m9" value="9: Search patient &amp; request access (UHID)" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="580" as="sourcePoint" /><mxPoint x="795" y="580" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: Send OTP to patient" style="html=1;endArrow=open;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="628" as="sourcePoint" /><mxPoint x="140" y="628" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: Share OTP (verbally)" style="html=1;endArrow=open;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="676" as="sourcePoint" /><mxPoint x="445" y="676" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: Input OTP for verification" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="724" as="sourcePoint" /><mxPoint x="795" y="724" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13: Generate AI Clinical Summary" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="758" as="sourcePoint" /><mxPoint x="805" y="792" as="targetPoint" /><Array as="points"><mxPoint x="895" y="758" /><mxPoint x="895" y="792" /></Array></mxGeometry></mxCell>
