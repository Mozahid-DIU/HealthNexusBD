        <mxCell id="m17" value="17: Real-time access notification" style="html=1;endArrow=open;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795" y="968" as="sourcePoint" /><mxPoint x="140" y="968" as="targetPoint" /></mxGeometry></mxCell>

