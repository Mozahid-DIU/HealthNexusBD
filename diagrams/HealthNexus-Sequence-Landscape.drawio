        <mxCell id="m5" value="5: Register with BMDC &amp; specialty" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="365" as="sourcePoint" /><mxPoint x="795" y="365" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: Request admin approval (verify BMDC)" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="415" as="sourcePoint" /><mxPoint x="1470" y="415" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: Approve doctor credentials" style="html=1;endArrow=open;dashed=1;strokeColor=#000000;fontSize=12;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1470" y="465" as="sourcePoint" /><mxPoint x="805" y="465" as="targetPoint" /></mxGeometry></mxCell>
