        <mxCell id="m15" value="15: Diagnose &amp; write prescription" style="html=1;endArrow=block;strokeColor=#000000;fontSize=12;verticalAlign=bottom;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="870" as="sourcePoint" /><mxPoint x="795" y="870" as="targetPoint" /></mxGeometry></mxCell>
